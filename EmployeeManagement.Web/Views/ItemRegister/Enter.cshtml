@using WebApp_Exercise.Presentations.ViewModels
@model DepartmentsViewModel
@{
    ViewData["Title"] = "商品登録（入力）";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5 col-sm-7">

            @* 送信先はControllerのConfirm()アクション*@
            <form asp-action="Confirm" asp-controller="Departments" method="post">

                @* 部門名 *@
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>


                <div class="text-center mt-4">
                    <button type="submit" class="btn btn-primary">完了</button>
                </div>
            </form>
        </div>
    </div>
</div>