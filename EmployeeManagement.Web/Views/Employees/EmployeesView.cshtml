@using WebApp_Exercise.Presentations.ViewModels
@model IEnumerable<EmployeesViewModel>
<table class="table">
    <thead>
        <tr>
            <th>社員ID</th>
            <th>社員番号</th>
            <th>氏名</th>
            <th>生年月日</th>
            <th>メールアドレス</th>
            <th>入社日</th>
            <th>部門ID</th>
            <th>部門名</th>
            <th>ステータス</th>
            <th>作成日時</th>
            <th>作成者</th>
            <th>更新日時</th>
            <th>更新者</th>
        </tr>
    </thead>
    <tbody>
          @foreach (var emp in Model)
            {
                <tr>
                    <td>@emp.Id</td>
                    <td>@emp.EmployeeNo</td>
                    <td>@emp.Name</td>
                    <td>@emp.Birthday</td>
                    <td>@emp.Email</td>
                    <td>@emp.HireDate</td>
                    <td>@emp.DeptId</td>
                    <td>@emp.DeptName</td>
                    <td>@emp.StatusText</td>
                    <td>@emp.CreatedAt</td>
                    <td>@emp.CreatedEmpNo</td>
                    <td>@emp.UpdatedAt</td>
                    <td>@emp.UpdatedEmpNo</td>
                </tr>
            }
    </tbody>
</table>