@using WebApp_Exercise.Presentations.ViewModels
@model EmployeesEnterViewModel
@{
    ViewData["Title"] = "社員登録（確認）";
}
<h2 class="text-center mt-4">@ViewData["Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-sm-8">

            <table class="table table-hover">
                <tbody>
                    <tr>
                        @* 社員番号を表示 *@
                        <td class="fw-bold">
                            @Html.DisplayNameFor(m => m.EmployeeNo)
                        </td>
                        <td>
                            @Html.DisplayFor(m => m.EmployeeNo)
                        </td>
                    </tr>

                    <tr>
                        @* 社員名を表示 *@
                        <td class="fw-bold">
                            @Html.DisplayNameFor(m => m.Name)
                        </td>
                        <td>
                            @Html.DisplayFor(m => m.Name)
                        </td>
                    </tr>

                    <tr>
                        @* 生年月日を表示 *@
                        <td class="fw-bold">
                            @Html.DisplayNameFor(m => m.Birthday)
                        </td>
                        <td>
                            @Html.DisplayFor(m => m.Birthday)
                        </td>
                    </tr>

                    <tr>
                        @* メールアドレスを表示 *@
                        <td class="fw-bold">
                            @Html.DisplayNameFor(m => m.Email)
                        </td>
                        <td>
                            @Html.DisplayFor(m => m.Email)
                        </td>
                    </tr>
                    <tr>
                        @* 入社日を表示 *@
                        <td class="fw-bold">
                            @Html.DisplayNameFor(m => m.HireDate)
                        </td>
                        <td>
                            @Html.DisplayFor(m => m.HireDate)
                        </td>
                    </tr>
                    <tr>
                        @* 部門IDを表示 *@
                        <td class="fw-bold">
                            @Html.DisplayNameFor(m => m.DeptId)
                        </td>
                        <td>
                            @Html.DisplayFor(m => m.DeptId)
                        </td>
                    </tr>
                    <tr>
                        @* 登録者IDを表示 *@
                        <td class="fw-bold">
                            @Html.DisplayNameFor(m => m.CreatedEmpNo)
                        </td>
                        <td>
                            @Html.DisplayFor(m => m.CreatedEmpNo)
                        </td>
                    </tr>
                </tbody>
            </table>

            <form>
                @* POST リクエスト(Register / Back)に値を渡すために hidden を使う *@
                @* これが無いと、次の画面で ViewModel の値が失われる *@
                <input type="hidden" asp-for="EmployeeNo" />
                <input type="hidden" asp-for="Name" />
                <input type="hidden" asp-for="Birthday" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="HireDate" />
                <input type="hidden" asp-for="DeptId" />
                <input type="hidden" asp-for="CreatedEmpNo" />

                @* formaction / formmethod
                   ボタンごとに送信先アクションを切り替える *@
                <div class="text-center mt-4">
                    <button type="submit"
                            formaction="@Url.Action("EmployeesRegister", "Employees")"
                            formmethod="post"
                            class="btn btn-primary">登録</button>

                    <button type="submit"
                            formaction="@Url.Action("EmployeesBack", "Employees")"
                            formmethod="post"
                            class="btn btn-secondary">戻る</button>
                </div>
            </form>
        </div>
    </div>
</div>